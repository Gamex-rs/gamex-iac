# Generate with: ./scripts/generate-dev-env.sh  (creates .env with a dev key pair)
# RS256 key pair, PEM with "\n" escapes. User Library signs with the private key; other services verify with the public key.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
RAWG_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
